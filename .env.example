# 复制为 .env；真实密码和 Token 只写 .env 或公司 CI 的 Secret。
# 环境变量优先于 configs/environments/<TEST_ENV>.yaml。
TEST_ENV=demo
# API_BASE_URL=https://api.test.example.com
# WEB_BASE_URL=https://test.example.com
# API_TOKEN=replace-with-a-test-token
# API_AUTH_FILE=configs/auth/example.yaml
# TEST_OPERATOR_USERNAME=your-test-username
# TEST_OPERATOR_PASSWORD=your-test-password
# TEST_TENANT_ID=your-test-tenant
# TEST_READER_TOKEN=your-reader-token
# TIMEOUT_SECONDS=20
# WEB_TIMEOUT_MS=10000

# Appium 服务可在本机，也可在远程 Mac / 设备实验室。
APPIUM_SERVER_URL=http://127.0.0.1:4723
APP_PLATFORM=android
# APP_CAPS_FILE=configs/devices/android.yaml
# 其余设备变量见 configs/devices/ 和 docs/04-app.md。

# AI 默认离线；只有 CLI 显式 --send 才向这个地址发送选定的输入文件。
# AI_BASE_URL=https://your-company-ai-gateway.example.com/v1
# AI_MODEL=your-approved-model-name
# AI_API_KEY=replace-with-your-key
